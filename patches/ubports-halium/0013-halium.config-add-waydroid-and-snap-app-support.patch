From b74d2cd54b1b3df1f77d0d7501cb2220d90b06e6 Mon Sep 17 00:00:00 2001
From: Jami Kettunen <jami.kettunen@protonmail.com>
Date: Sat, 8 Jun 2024 01:40:46 +0300
Subject: [PATCH 13/18] halium.config: add waydroid and snap app support

---
 arch/arm64/configs/halium.config | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm64/configs/halium.config b/arch/arm64/configs/halium.config
index aade174b5..716a91098 100644
--- a/arch/arm64/configs/halium.config
+++ b/arch/arm64/configs/halium.config
@@ -16,3 +16,17 @@ CONFIG_BT_HCIVHCI=y
 CONFIG_SECURITY_APPARMOR=y
 CONFIG_DEFAULT_SECURITY_APPARMOR=y
 CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,apparmor,selinux,smack,tomoyo,bpf"
+
+# Waydroid
+CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder,anbox-binder,anbox-hwbinder,anbox-vndbinder"
+CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
+CONFIG_SQUASHFS=y
+CONFIG_SQUASHFS_FILE_DIRECT=y
+CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
+# Snap
+CONFIG_SQUASHFS_LZ4=y
+CONFIG_SQUASHFS_LZO=y
+CONFIG_SQUASHFS_XZ=y
+CONFIG_SQUASHFS_ZSTD=y
+# FIXME: breaks GKI ABI somehow, needed by some snaps like btop & qtcreator
+#CONFIG_CGROUP_DEVICE=y
-- 
2.53.0

