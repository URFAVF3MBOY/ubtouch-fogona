#!/bin/sh
# fogona debug (initramfs init-top): every 0.2 s, write the kernel log, mounts
# and processes into one of 100 rotating 256 KB slots in the first 25 MB of
# vendor_boot_b (unused slot, readable with `fastboot fetch vendor_boot_b` from
# fastbootd), so the last snapshot before a hang/reboot survives. Background.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in prereqs) prereqs; exit 0 ;; esac
(
  dev=""
  for i in $(seq 1 60); do
    for u in /sys/class/block/*/uevent; do
      grep -q '^PARTNAME=vendor_boot_b$' "$u" 2>/dev/null || continue
      eval "$(grep -E '^(MAJOR|MINOR)=' "$u")"
      dev=/dev/fdbg_log; [ -b $dev ] || mknod $dev b $MAJOR $MINOR
    done
    [ -n "$dev" ] && break; sleep 1
  done
  [ -n "$dev" ] || exit 0
  n=0
  while [ $n -lt 3000 ]; do
    {
      echo "### FOGONA-INITRD-LOG n=$n uptime=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)"
      dmesg | tail -150
      echo "### MOUNTS"; cat /proc/mounts 2>/dev/null
      echo "### PS"; ps 2>/dev/null
      echo "### UDC: $(ls /sys/class/udc 2>/dev/null) NET: $(ls /sys/class/net 2>/dev/null)"
      echo "### END"
    } > /run/fdbg-initrd.txt 2>&1
    dd if=/run/fdbg-initrd.txt of=$dev bs=262144 count=1 seek=$((n % 100)) conv=notrunc,fsync 2>/dev/null
    usleep 200000; n=$((n+1))
  done
) </dev/null >/dev/null 2>&1 &
