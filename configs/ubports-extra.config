# On top of UBports' android13-5.15-halium halium.config (which keeps the GKI
# module ABI, so the phone's stock vendor modules load).
# Google's build generates the KMI export allow-list; plain make can't.
CONFIG_TRIM_UNUSED_KSYMS=n
CONFIG_LOCALVERSION="-halium"
# Base is the phone's config (full LTO): ThinLTO per halium.config fits a 16 GB runner.
# Keep DEBUG_INFO/BTF on: CONFIG_DEBUG_INFO_BTF_MODULES adds btf fields to struct
# module, and dropping them changes the CRC of nearly every exported symbol.
CONFIG_LTO_CLANG_FULL=n
CONFIG_LTO_CLANG_THIN=y
# UBports turns this off, but then unsigned vendor modules go through the
# upstream lockdown check, which Android's SELinux policy denies
# (avc: denied { integrity } ... "unsigned module loading"), so
# vendor_modprobe.sh never sets vendor.all.modules.ready and init waits forever
# on `wait_for_prop` in init.qti.kernel.rc. Stock GKI has it on.
CONFIG_MODULE_SIG_PROTECT=y
# GKI drops RNDIS (keeps NCM/ECM), but the Halium initrd debug telnet and
# Ubuntu Touch's USB tethering/SSH both use RNDIS, and it's the USB network
# class Windows supports out of the box.
CONFIG_USB_CONFIGFS_RNDIS=y
