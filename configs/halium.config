# Halium / Ubuntu Touch requirements, applied on top of stock-fogona.config
# (the config pulled from /proc/config.gz on the running phone).

# Namespaces / IPC needed by systemd, lxc-android and Ubuntu userspace
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y

# systemd
CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y

# AppArmor (Ubuntu Touch app confinement); SELinux stays built in for Android
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,apparmor,selinux,bpf"

# Remaining items from Halium's check-kernel-config that still exist on 5.15
# (most of its list is 3.x-era and renamed/removed upstream)
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUP_PERF=y
CONFIG_DNOTIFY=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_IP6_NF_MATCH_IPV6HEADER=y
CONFIG_IP6_NF_MATCH_FRAG=y
CONFIG_DNS_RESOLVER=y

# Graphics fences used by the Android HAL stack under libhybris
CONFIG_SW_SYNC=y

# Snaps / squashfs images
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# Container networking for lxc-android
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_IP6_NF_NAT=y

# We rebuild every vendor module against this kernel, so the GKI symbol
# trimming and protected-export restrictions only get in the way.
CONFIG_TRIM_UNUSED_KSYMS=n
CONFIG_MODULE_SIG_PROTECT=n

# Stock GKI is built with full LTO + debug info, which runs a 16 GB CI
# runner out of memory. Neither is needed here (CFI goes away with LTO).
CONFIG_LTO_NONE=y
CONFIG_LTO_CLANG_FULL=n
CONFIG_CFI_CLANG=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=n

CONFIG_LOCALVERSION="-halium"
CONFIG_LOCALVERSION_AUTO=n
