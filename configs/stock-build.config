# "Stock-equivalent" variant: the phone's own config, so the prebuilt vendor
# modules still load. Used to prove the source/toolchain/boot image pipeline
# boots before the Halium changes. Only the LTO mode changes (full LTO runs a
# 16 GB runner out of memory); ThinLTO keeps CFI, which the vendor modules expect.
CONFIG_LTO_CLANG_THIN=y
CONFIG_LTO_CLANG_FULL=n
# Google's build generates the KMI export allow-list; plain make can't.
# Trimming only removes exports, it doesn't change symbol CRCs.
CONFIG_TRIM_UNUSED_KSYMS=n
